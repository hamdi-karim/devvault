# Database (Neon)
# Pooled connection (hostname contains -pooler), used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no -pooler), used by the Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js
# Generate with: npx auth secret (or: openssl rand -base64 32)
AUTH_SECRET=
# GitHub OAuth App (https://github.com/settings/developers)
# Redirect URI: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Resend (https://resend.com/api-keys)
# onboarding@resend.dev only delivers to the Resend account owner; use a verified domain for real users
RESEND_API_KEY=
EMAIL_FROM="DevVault <onboarding@resend.dev>"
# Require email verification for email/password sign-up (on unless set to "false").
# Set to "false" while Resend has no verified domain.
EMAIL_VERIFICATION_ENABLED=true
# Public base URL used in emailed links (never derived from the request Host header)
APP_URL="http://localhost:3000"

# Upstash Redis (https://console.upstash.com), used for rate limiting
# REST URL and token from the database's "REST API" section. Keys are prefixed per environment, so one database can be shared
UPSTASH_REDIS_REST_URL="https://YOUR-DATABASE.upstash.io"
UPSTASH_REDIS_REST_TOKEN=